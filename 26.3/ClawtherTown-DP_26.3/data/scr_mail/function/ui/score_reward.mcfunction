data modify storage scr_mail:runtime work.score_name set value {"text":"","color":"gold","italic":false}
data modify storage scr_mail:runtime work.score_name.text set from storage scr_mail:runtime work.entry.parameters.objective
execute if data storage scr_mail:runtime work.entry.parameters{objective:"clawther_coin"} run data modify storage scr_mail:runtime work.score_name set value {"translate":"item.scr.clawther_coin","fallback":"鹰翎币","color":"gold","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"mystic_coin"} run data modify storage scr_mail:runtime work.score_name set value {"translate":"score.scr.mystic_coin","fallback":"秘币","color":"gold","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"dream_wing"} run data modify storage scr_mail:runtime work.score_name set value {"translate":"score.scr.dream_wing","fallback":"幻梦翎片","color":"gold","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"soul"} run data modify storage scr_mail:runtime work.score_name set value {"translate":"item.scr.soul","fallback":"灵魂","color":"gold","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"stage"} run data modify storage scr_mail:runtime work.score_name set value {"translate":"gui.scr.mail.reward.unlock","fallback":"解锁奖励","color":"gold","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"title_special_4"} run data modify storage scr_mail:runtime work.score_name set value {"translate":"team.scr.title_special_4.prefix","fallback":" [万象更新] ","color":"gold","italic":false}
data modify storage scr_mail:runtime work.reward_label set value {"text":"","color":"gold","italic":false,"extra":[{},{}]}
data modify storage scr_mail:runtime work.reward_label.extra[0] set from storage scr_mail:runtime work.score_name
$execute if data storage scr_mail:runtime work.entry.parameters{operation:"add"} run data modify storage scr_mail:runtime work.reward_label.extra[1] set value {text:" +$(value)",color:"yellow"}
$execute if data storage scr_mail:runtime work.entry.parameters{operation:"set"} run data modify storage scr_mail:runtime work.reward_label.extra[1] set value {text:" → $(value)",color:"yellow"}
$execute if data storage scr_mail:runtime work.entry.parameters{operation:"add"} run data modify storage scr_mail:runtime work.reward_info set value {"translate":"gui.scr.mail.reward.score_add_description","fallback":"领取后增加 %s !","with":[{"text":"$(value)"}],"color":"gray","italic":false}
$execute if data storage scr_mail:runtime work.entry.parameters{operation:"set"} run data modify storage scr_mail:runtime work.reward_info set value {"translate":"gui.scr.mail.reward.score_set_description","fallback":"领取后更新为 %s !","with":[{"text":"$(value)"}],"color":"gray","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"title_special_4",operation:"set",value:1} run data modify storage scr_mail:runtime work.reward_label set value {"translate":"gui.scr.mail.reward.unlock_title","fallback":"解锁称号: %s","with":[{"translate":"team.scr.title_special_4.prefix","fallback":" [万象更新] ","color":"aqua"}],"color":"gold","italic":false}
execute if data storage scr_mail:runtime work.entry.parameters{objective:"title_special_4",operation:"set",value:1} run data modify storage scr_mail:runtime work.reward_info set value {"translate":"gui.scr.mail.reward.unlock_title_description","fallback":"领取后可解锁该称号!","color":"gray","italic":false}
