data modify storage scr_sky:ui work.line set value {"translate":"gui.scr.sky.job","fallback":"最近操作：%s","color":"white","with":[{"text":""}]}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{outcome:"claimed"} run data modify storage scr_sky:ui work.line.with[0] set value {"translate":"gui.scr.sky.outcome_claimed","fallback":"空岛已创建","color":"white"}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{outcome:"reserved"} run data modify storage scr_sky:ui work.line.with[0] set value {"translate":"gui.scr.sky.outcome_reserved","fallback":"测试岛数据已保留，尚未放置模板","color":"white"}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{outcome:"transferred"} run data modify storage scr_sky:ui work.line.with[0] set value {"translate":"gui.scr.sky.outcome_transferred","fallback":"拥有者已转让","color":"white"}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{outcome:"teleported"} run data modify storage scr_sky:ui work.line.with[0] set value {"translate":"gui.scr.sky.outcome_teleported","fallback":"已传送","color":"white"}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{outcome:"recovery"} run data modify storage scr_sky:ui work.line.with[0] set value {"translate":"gui.scr.sky.outcome_recovery","fallback":"操作未完成；请查看原因，已分配岛号不会自动释放","color":"white"}
data modify storage scr_sky:ui work.dialog.body append value {type:"minecraft:plain_message",contents:{text:""},width:380}
data modify storage scr_sky:ui work.dialog.body[-1].contents set from storage scr_sky:ui work.line
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"starter_volume_not_empty_or_occupied"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_starter_volume_not_empty_or_occupied","fallback":"模板区域有方块或玩家，未覆盖现有内容。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"placement_failed"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_placement_failed","fallback":"Starter 放置未成功，岛号已保留供检查。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"starter_spawn_unsafe"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_starter_spawn_unsafe","fallback":"默认出生点未通过安全检查，岛号已保留。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"reload_or_restart"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_reload_or_restart","fallback":"重载或重启中断了操作，未自动重放。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"timeout_or_function_error"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_timeout_or_function_error","fallback":"操作超时或执行异常，请联系管理员检查。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"admin_abort"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_admin_abort","fallback":"管理员已中止操作。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"allocator_record_exists"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.error_allocator_record_exists","fallback":"分配器目标已有记录，已停止分配。","color":"white"},"width":380}
execute if data storage scr_sky:ui work.snapshot.player.last_operation{error:"owner_exists_or_inconsistent"} run data modify storage scr_sky:ui work.dialog.body append value {"type":"minecraft:plain_message","contents":{"translate":"gui.scr.sky.owner_exists_or_inconsistent","fallback":"权威记录显示目标玩家已经拥有岛屿，或所有权缓存不一致；操作已拒绝。","color":"white"},"width":380}
