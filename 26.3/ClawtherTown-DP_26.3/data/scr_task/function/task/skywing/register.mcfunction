data modify storage scr_task:runtime catalog append value {"id":"skywing/sky_03_02","group":"skywing","name":"sky_03_02","title":"SKY-03-02 · 甜蜜的成果","requires":[],"objectives":[{"kind":"item","field":"held_cake","item":"minecraft:cake","count":1,"target":1,"delivery_goal":"cake"}],"subtasks":[{"field":"held_cake","target":1,"label":{"translate":"task.scr.skywing.sky_03_02.objective.cake","fallback":"蛋糕","color":"white"}},{"field":"delivered_cake","target":1,"label":{"translate":"task.scr.skywing.sky_03_02.objective.cake","fallback":"蛋糕","color":"white"}}],"ui":{"title":{"translate":"task.scr.skywing.sky_03_02.title","fallback":"甜蜜的成果","color":"gold"},"description":{"translate":"task.scr.skywing.sky_03_02.description","fallback":"用3桶牛奶、2个糖、1个鸡蛋和3个小麦制作并提交蛋糕1个。奖励的喷溅型虚弱药水和普通金苹果可以救治僵尸村民：先将它安全围住，投掷药水，再对它使用金苹果并等待康复。","color":"white"},"accept":{"translate":"task.scr.skywing.sky_03_02.accept","fallback":"田野、牧场与炉边的努力，可以在一块蛋糕里相遇。带来一份真正属于这座岛的甜点吧。","color":"white"},"complete":{"translate":"task.scr.skywing.sky_03_02.complete","fallback":"这份甜意值得分享。奖励里的喷溅型虚弱药水和普通金苹果，还能给僵尸村民一次重返日光的机会。","color":"white"}},"hooks":{"start":"scr_task:task/skywing/shared/refresh","refresh":"scr_task:task/skywing/shared/refresh","check_ready":"scr_task:task/skywing/shared/check_ready","reward":"scr_task:task/skywing/sky_03_02/reward","unlock":"scr_task:task/skywing/shared/unlock"},"chapter_line":"skywing","chapter_name":"ch_03","chapter":3,"inventory_required":true,"deliveries":[{"id":"cake","field":"delivered_cake","consume":true,"items":[{"item":"minecraft:cake","count":1,"field":"cake","label":{"translate":"task.scr.skywing.sky_03_02.objective.cake","fallback":"蛋糕","color":"white"}}],"label":{"translate":"task.scr.skywing.sky_03_02.objective.cake","fallback":"蛋糕","color":"white"},"held_field":"held_cake"}],"delivery_policy":{"predicate":"scr_profile:profile/sky","profile":5}}
data modify storage scr_task:runtime catalog append value {"id":"skywing/sky_03_03","group":"skywing","name":"sky_03_03","title":"SKY-03-03 · 黏性动力","requires":[],"objectives":[{"kind":"item","field":"slime_ball","item":"minecraft:slime_ball","count":16,"target":16},{"kind":"item","field":"sticky_piston","item":"minecraft:sticky_piston","count":2,"target":2}],"subtasks":[{"field":"slime_ball","target":16,"label":{"translate":"task.scr.skywing.sky_03_03.objective.slime_ball","fallback":"史莱姆球","color":"white"}},{"field":"sticky_piston","target":2,"label":{"translate":"task.scr.skywing.sky_03_03.objective.sticky_piston","fallback":"黏性活塞","color":"white"}}],"ui":{"title":{"translate":"task.scr.skywing.sky_03_03.title","fallback":"黏性动力","color":"gold"},"description":{"translate":"task.scr.skywing.sky_03_03.description","fallback":"收集史莱姆球16个，并制作黏性活塞2个。可在岛屿范围内向下扩建，在Y<40的史莱姆区块搭建平台，留足空间，以非和平难度等待史莱姆生成。用电梯往返，也可用水和熔岩浇筑支撑；4个幻翼膜还能合成4个史莱姆球。","color":"white"},"accept":{"translate":"task.scr.skywing.sky_03_03.accept","fallback":"云下还有很深的空间。若找到了史莱姆区块，低处的平台也能成为一间特别的工坊。","color":"white"},"complete":{"translate":"task.scr.skywing.sky_03_03.complete","fallback":"黏性活塞已经握在手中。让这些红石与金属，替下一座设施添一点巧思。","color":"white"}},"hooks":{"start":"scr_task:task/skywing/shared/refresh","refresh":"scr_task:task/skywing/shared/refresh","check_ready":"scr_task:task/skywing/shared/check_ready","reward":"scr_task:task/skywing/sky_03_03/reward","unlock":"scr_task:task/skywing/shared/unlock"},"chapter_line":"skywing","chapter_name":"ch_03","chapter":3,"inventory_required":true}
