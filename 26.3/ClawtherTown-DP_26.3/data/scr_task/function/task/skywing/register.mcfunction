data modify storage scr_task:runtime catalog append value {"id":"skywing/sky_02_13","group":"skywing","name":"sky_02_13","title":"SKY-02-13 · 牧场开张","requires":[],"objectives":[{"kind":"event","field":"cow","target":1},{"kind":"event","field":"chicken","target":1}],"subtasks":[{"field":"cow","target":1,"label":{"translate":"task.scr.skywing.sky_02_13.objective.cow","fallback":"成功繁殖牛","color":"white"},"ui":{"tooltip_description":{"translate":"task.scr.skywing.sky_02_13.tutorial.cow","fallback":"用干草块和皮革合成牛生成蛋，准备两头成年牛；接取任务后用小麦喂它们，繁殖一头小牛。","color":"gray"}}},{"field":"chicken","target":1,"label":{"translate":"task.scr.skywing.sky_02_13.objective.chicken","fallback":"成功繁殖鸡","color":"white"},"ui":{"tooltip_description":{"translate":"task.scr.skywing.sky_02_13.tutorial.chicken","fallback":"用干草块和小麦种子合成鸡生成蛋，准备两只成年鸡；接取任务后用种子喂它们，繁殖一只小鸡。","color":"gray"}}}],"ui":{"title":{"translate":"task.scr.skywing.sky_02_13.title","fallback":"牧场开张","color":"gold"},"description":{"translate":"task.scr.skywing.sky_02_13.description","fallback":"用8个干草块围住1个皮革可合成牛生成蛋，围住1个小麦种子可合成鸡生成蛋。钓鱼也有机会获得皮革。准备两头牛和两只鸡，接取任务后用小麦喂牛、种子喂鸡，各繁殖一次。","color":"white"},"accept":{"translate":"task.scr.skywing.sky_02_13.accept","fallback":"有了麦田，就能为新邻居准备食物。先围好牧场，再请牛与鸡住进来。","color":"white"},"complete":{"translate":"task.scr.skywing.sky_02_13.complete","fallback":"小牛与小鸡的脚步，让小岛热闹了起来。给它们留足地方，也给未来留一份奶与蛋。","color":"white"}},"hooks":{"start":"scr_task:task/skywing/shared/refresh","refresh":"scr_task:task/skywing/shared/refresh","check_ready":"scr_task:task/skywing/shared/check_ready","reward":"scr_task:task/skywing/sky_02_13/reward","unlock":"scr_task:task/skywing/shared/unlock"},"chapter_line":"skywing","chapter_name":"ch_02","chapter":2}
