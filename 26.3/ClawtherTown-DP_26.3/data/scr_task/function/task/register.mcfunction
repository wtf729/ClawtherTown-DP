data modify storage scr_task:runtime catalog append value {"id":"guardian/g_01","group":"guardian","name":"g_01","title":"初临鹰翎","requires":[],"hooks":{"start":"scr_task:task/guardian/g_01/start","check_complete":"scr_task:task/guardian/g_01/check_complete","reward":"scr_task:task/guardian/g_01/reward"},"subtasks":[{"field":"menu","target":1,"label":{"translate":"task.scr.guardian.g_01.objective.menu","fallback":"打开快捷菜单","color":"white"}},{"field":"help","target":1,"label":{"translate":"task.scr.guardian.g_01.objective.help","fallback":"打开知识之书","color":"white"}}],"ui":{"title":{"translate":"task.scr.guardian.g_01.title","fallback":"初临鹰翎","color":"gold"},"description":{"translate":"task.scr.guardian.g_01.description","fallback":"初来鹰翎镇，先了解这里最基本的功能与规则。","color":"white"},"objectives":{"translate":"task.scr.guardian.g_01.instructions","fallback":"使用 /trigger i 打开快捷菜单；使用 /trigger scrhelp 打开知识之书。","color":"white"},"rewards":{"translate":"task.scr.guardian.g_01.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、300 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.guardian.g_01.accept","fallback":"欢迎来到鹰翎镇!\n\n这里和你熟悉的世界有些不同。商店、邮件、住处，还有一些只在这里行得通的规矩……一开始确实不少。\n\n不过不用急着全部记住。\n\n先打开快捷菜单看看，再翻一翻知识之书。\n\n相信我，它们会帮上忙。","color":"white"},"submit":{"translate":"task.scr.guardian.g_01.submit","fallback":"很好。\n\n至少现在，你知道遇到问题时该从哪里找答案了。\n\n至于剩下的——亲自去看看，比听我讲一遍有用得多。\n\n拿着这些鹰翎币。镇上的商人应该很乐意教你怎么把它们花出去。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"guardian/g_02","group":"guardian","name":"g_02","title":"快车初体验","requires":[{"group":"guardian","name":"g_01"}],"hooks":{"start":"scr_task:task/guardian/g_02/start","check_complete":"scr_task:task/guardian/g_02/check_complete","reward":"scr_task:task/guardian/g_02/reward"},"subtasks":[{"field":"home_set","target":1,"label":{"translate":"task.scr.guardian.g_02.objective.home_set","fallback":"设置一个 Home","color":"white"}},{"field":"returned","target":1,"label":{"translate":"task.scr.guardian.g_02.objective.returned","fallback":"通过 Home 成功返回","color":"white"}}],"ui":{"title":{"translate":"task.scr.guardian.g_02.title","fallback":"快车初体验","color":"gold"},"description":{"translate":"task.scr.guardian.g_02.description","fallback":"给自己留下第一个可以随时返回的位置。","color":"white"},"objectives":{"translate":"task.scr.guardian.g_02.instructions","fallback":"使用 /trigger sethome 设置 Home #1，再用 /trigger home 返回。已有合法 Home 也会计入第一项目标。","color":"white"},"rewards":{"translate":"task.scr.guardian.g_02.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、50 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.guardian.g_02.accept","fallback":"鹰翎镇不小，你以后去的地方只会更多。\n\n所以在出发之前，最好先学会怎么回来。\n\n先找一个你觉得合适的位置，把它设成 Home。\n\n然后去别处走走，再试着回来一次。","color":"white"},"submit":{"translate":"task.scr.guardian.g_02.submit","fallback":"不错。\n\n知道目的地在哪里很重要，知道回家的路同样重要。\n\n不过一个 Home，只是最简单的用法。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"guardian/g_03","group":"guardian","name":"g_03","title":"快车再体验","requires":[{"group":"guardian","name":"g_02"}],"hooks":{"check_complete":"scr_task:task/guardian/g_03/check_complete","reward":"scr_task:task/guardian/g_03/reward"},"subtasks":[{"field":"numbered_set","target":1,"label":{"translate":"task.scr.guardian.g_03.objective.numbered_set","fallback":"成功设置一个编号大于 1 的 Home","color":"white"}},{"field":"numbered_returned","target":1,"label":{"translate":"task.scr.guardian.g_03.objective.numbered_returned","fallback":"成功返回一个编号大于 1 的 Home","color":"white"}},{"field":"list","target":1,"label":{"translate":"task.scr.guardian.g_03.objective.list","fallback":"打开 Home 列表","color":"white"}}],"ui":{"title":{"translate":"task.scr.guardian.g_03.title","fallback":"快车再体验","color":"gold"},"description":{"translate":"task.scr.guardian.g_03.description","fallback":"学习编号 Home，并查看 Home 列表。","color":"white"},"objectives":{"translate":"task.scr.guardian.g_03.instructions","fallback":"接取后，用 /trigger sethome set 2 设置编号 Home，用 /trigger home set 3 返回已有的编号 Home，再用 /trigger homes 查看列表。设置和返回的编号都须大于 1，但不必相同；只有成功操作才算完成。","color":"white"},"rewards":{"translate":"task.scr.guardian.g_03.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、100 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.guardian.g_03.accept","fallback":"一个 Home 用顺手了吗？\n\n那就该试试更方便的用法了。\n\n你可以给不同的位置分别留下 Home。\n\n矿区、基地、常去的地方……只要记住对应的序号，就能随时选择要回到哪里。\n\n再设置一个带序号的 Home，试着返回一次。\n\n如果哪天记不清自己设过哪些位置，就打开 Home 列表看看。","color":"white"},"submit":{"translate":"task.scr.guardian.g_03.submit","fallback":"这就对了。\n\n一个 Home 是归处，多个 Home 才真正像一张属于你自己的路线图。\n\n以后常去的地方，不妨都留一个位置。\n\n不过有时候，你甚至不需要输入命令就能回来。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"guardian/g_04","group":"guardian","name":"g_04","title":"归途与归宿","requires":[{"group":"guardian","name":"g_03"},{"group":"broker","name":"b_02"}],"hooks":{"start":"scr_task:task/guardian/g_04/start","check_complete":"scr_task:task/guardian/g_04/check_complete","reward":"scr_task:task/guardian/g_04/reward"},"subtasks":[{"field":"teleport_cookie","target":1,"label":{"translate":"task.scr.guardian.g_04.objective.teleport_cookie","fallback":"获得紫颂曲奇","color":"white"}},{"field":"soul_cookie","target":1,"label":{"translate":"task.scr.guardian.g_04.objective.soul_cookie","fallback":"获得灵魂曲奇","color":"white"}}],"ui":{"title":{"translate":"task.scr.guardian.g_04.title","fallback":"归途与归宿","color":"gold"},"description":{"translate":"task.scr.guardian.g_04.description","fallback":"认识紫颂曲奇与灵魂曲奇，为远行做好准备。","color":"white"},"objectives":{"translate":"task.scr.guardian.g_04.instructions","fallback":"地面合成：火把 ×1 + 金粒 ×1 → 紫颂曲奇；火把 ×1 + 铁粒 ×1 → 灵魂曲奇。获得即可，无需亲自合成或食用。紫颂曲奇返回 Home #1；灵魂曲奇将食用位置设为重生点。","color":"white"},"rewards":{"translate":"task.scr.guardian.g_04.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、100 鹰翎币、6 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.guardian.g_04.accept","fallback":"既然你已经给自己留好了落脚的地方，我再教你两样适合随身带着的东西。\n\n火把和金粒丢在一起，可以做成紫颂曲奇。\n\n火把换成铁粒，则会得到灵魂曲奇。\n\n一个管你怎么回去，一个管你倒下以后从哪里重新开始。\n\n别小看它们。走得越远，这两块曲奇越可能替你省下一大段路。","color":"white"},"submit":{"translate":"task.scr.guardian.g_04.submit","fallback":"记住它们的区别。\n\n紫颂曲奇会把你送回 Home #1。\n\n灵魂曲奇则会把你吃下它的位置设为新的重生点。\n\n至于紫颂曲奇……最好留意一下它的配方用途。\n\n它还能成为一种更可靠的归途。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"guardian/g_05","group":"guardian","name":"g_05","title":"指引明路的苍蓝星","requires":[{"group":"guardian","name":"g_04"}],"hooks":{"start":"scr_task:task/guardian/g_05/start","check_complete":"scr_task:task/guardian/g_05/check_complete","reward":"scr_task:task/guardian/g_05/reward"},"subtasks":[{"field":"staff","target":1,"label":{"translate":"task.scr.guardian.g_05.objective.staff","fallback":"获得苍蓝星法杖","color":"white"}}],"ui":{"title":{"translate":"task.scr.guardian.g_05.title","fallback":"指引明路的苍蓝星","color":"gold"},"description":{"translate":"task.scr.guardian.g_05.description","fallback":"获得苍蓝星法杖，为归途点亮一颗不会熄灭的星。","color":"white"},"objectives":{"translate":"task.scr.guardian.g_05.instructions","fallback":"配方：紫颂曲奇 ×1、钻石 ×2、木棍 ×2、鹰翎 ×4。获得即可完成，无需亲自制作或使用。法杖可无限次瞬间返回 Home #1。","color":"white"},"rewards":{"translate":"task.scr.guardian.g_05.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、150 鹰翎币、6 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.guardian.g_05.accept","fallback":"紫颂曲奇很好用。\n\n唯一的问题，是每回去一次，就会少一块。\n\n如果你已经开始频繁往返，那就该准备一种更长久的办法了。\n\n一块紫颂曲奇、两颗钻石、两根木棍，再加四枚鹰翎。\n\n把它们做成苍蓝星法杖。\n\n只要你的 Home #1 还在那里，它就会一直记得回去的方向。","color":"white"},"submit":{"translate":"task.scr.guardian.g_05.submit","fallback":"很好。\n\n以后迷路的时候，抬头找不到星星也没关系。\n\n你手里的这颗苍蓝星，会替你指路。\n\n它可以反复使用，并立即将你送回 Home #1。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"courier/c_01","group":"courier","name":"c_01","title":"驿站来信","requires":[{"group":"guardian","name":"g_01"}],"hooks":{"start":"scr_task:task/courier/c_01/start","check_complete":"scr_task:task/courier/c_01/check_complete","reward":"scr_task:task/courier/c_01/reward","refresh":"scr_task:task/courier/c_01/sync"},"subtasks":[{"field":"gift","target":1,"label":{"translate":"task.scr.courier.c_01.objective.gift","fallback":"完整领取任务新人礼邮件","color":"white"}}],"ui":{"title":{"translate":"task.scr.courier.c_01.title","fallback":"驿站来信","color":"gold"},"description":{"translate":"task.scr.courier.c_01.description","fallback":"领取驿差鹰寄来的新人礼，学习使用邮箱。","color":"white"},"objectives":{"translate":"task.scr.courier.c_01.instructions","fallback":"接取任务后，驿站会为你寄来一份新人礼。打开邮箱，在鹰翎镇领取整封邮件即可完成任务。","color":"white"},"rewards":{"translate":"task.scr.courier.c_01.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、50 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.courier.c_01.accept","fallback":"等等，你就是刚来的那位吧？\n\n正好，有你的东西。\n\n以前总有人觉得奖励一定得当场塞进背包。结果背包一满，东西掉得满地都是，最后还是得我收拾。\n\n所以现在，重要的东西都先送到驿站。\n\n我刚给你寄了一份见面礼。打开邮箱，把它领走吧。\n\n放心，送到你名下的东西，我可不会转手卖给行商鹰。","color":"white"},"submit":{"translate":"task.scr.courier.c_01.submit","fallback":"看吧，就这么简单。\n\n以后不管是任务奖励、活动奖励，还是你一时没空领取的东西，都可能先来我这里。\n\n记得偶尔看看邮箱。\n\n还有，这些灵魂算是第一次来驿站的附赠。别告诉行商鹰我这么大方。","color":"white"}},"start_items":{"title":"任务新人礼","source":"task/courier/c_01/start_items","event_id":"","claim_profile":"main","rewards":[{"handler":"item","parameters":{"stack":{"id":"minecraft:iron_sword","count":1}}},{"handler":"item","parameters":{"stack":{"id":"minecraft:iron_pickaxe","count":1}}},{"handler":"item","parameters":{"stack":{"id":"minecraft:bread","count":64}}},{"handler":"item","parameters":{"stack":{"id":"minecraft:oak_log","count":16}}},{"handler":"item","parameters":{"stack":{"id":"minecraft:torch","count":64}}},{"handler":"loot","parameters":{"table":"scr:card/card_clawther_coin_double_v"}},{"handler":"loot","parameters":{"table":"scr:card/card_soul_double_v"}}]}}
data modify storage scr_task:runtime catalog append value {"id":"broker/b_01","group":"broker","name":"b_01","title":"有利可图的生意","requires":[{"group":"guardian","name":"g_01"}],"hooks":{"start":"scr_task:task/broker/b_01/start","check_complete":"scr_task:task/broker/b_01/check_complete","reward":"scr_task:task/broker/b_01/reward"},"subtasks":[{"field":"trade","target":1,"label":{"translate":"task.scr.broker.b_01.objective.trade","fallback":"完成普通商品购买或出售","color":"white"}}],"ui":{"title":{"translate":"task.scr.broker.b_01.title","fallback":"有利可图的生意","color":"gold"},"description":{"translate":"task.scr.broker.b_01.description","fallback":"完成第一笔普通商品交易。","color":"white"},"objectives":{"translate":"task.scr.broker.b_01.instructions","fallback":"使用 /trigger shop。普通商品全部交付，或至少出售一件物品并结算，即可完成。推荐购买奇珍煤炭，但不强制；箱子、钥匙和开箱不计入。","color":"white"},"rewards":{"translate":"task.scr.broker.b_01.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、100 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.broker.b_01.accept","fallback":"三百鹰翎币？\n\n看来神鹰终于舍得让新人带点钱来见我了。\n\n很好。钱放在口袋里只是一串数字，花出去以后才知道它值什么。\n\n打开商店，买点东西，或者卖点你不需要的材料都行。\n\n不过如果你想听我的建议——先买一块奇珍煤炭。\n\n现在用不上？那最好。\n\n真正有价值的东西，本来就不该只看眼前。","color":"white"},"submit":{"translate":"task.scr.broker.b_01.submit","fallback":"很好，第一笔生意做成了。\n\n记住，我不在乎你买了什么，也不在乎你卖了什么。\n\n重要的是，你现在知道东西可以流通，而不是永远堆在箱子里吃灰。\n\n如果你听了我的建议买了奇珍煤炭，就先收好。\n\n很快你会知道它为什么值这个价。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"broker/b_02","group":"broker","name":"b_02","title":"镐匠 · I","requires":[{"group":"broker","name":"b_01"}],"hooks":{"start":"scr_task:task/broker/b_02/start","check_complete":"scr_task:task/broker/b_02/check_complete","reward":"scr_task:task/broker/b_02/reward"},"subtasks":[{"field":"pickaxe","target":1,"label":{"translate":"task.scr.broker.b_02.objective.pickaxe","fallback":"获得任意等级翎之镐","color":"white"}}],"ui":{"title":{"translate":"task.scr.broker.b_02.title","fallback":"镐匠 · I","color":"gold"},"description":{"translate":"task.scr.broker.b_02.description","fallback":"认识高级工作台，获得第一把翎之镐。","color":"white"},"objectives":{"translate":"task.scr.broker.b_02.instructions","fallback":"在投掷器的九格中按配方放入普通铁镐 ×1、鹰翎 ×8，再站到投掷器上，即可制作翎之镐 I。幻梦翎片可交给行商鹰开启，有机会获得制作所需的鹰翎。获得任意等级的翎之镐均可完成目标。","color":"white"},"rewards":{"translate":"task.scr.broker.b_02.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、150 鹰翎币、6 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.broker.b_02.accept","fallback":"你应该已经见过幻梦翎片了。\n\n在这里待上一段时间，它自然会落到你手里。\n\n把它拿来，我可以替你开启。运气不错的话，你会得到鹰翎。\n\n鹰翎可不只是收藏品。\n\n准备一把普通铁镐，再凑齐八枚鹰翎。\n\n然后找一只投掷器。\n\n九格材料按正确的位置摆好，再站到上面。\n\n我们管这种做法叫——高级工作台。\n\n试着做出你的第一把翎之镐。","color":"white"},"submit":{"translate":"task.scr.broker.b_02.submit","fallback":"成了。\n\n不过别急着把它当成普通铁镐用。\n\n检查一下镐子上的说明。\n\n翎之镐还能继续成长。\n\n还记得刚才我让你买的奇珍煤炭吗？\n\n如果你愿意，可以拿它试试看。\n\n当然，接下来就不属于免费教学的范围了。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"timekeeper/t_01","group":"timekeeper","name":"t_01","title":"天降鹰翎","requires":[{"group":"guardian","name":"g_01"}],"hooks":{"start":"scr_task:task/timekeeper/t_01/start","check_complete":"scr_task:task/timekeeper/t_01/check_complete","reward":"scr_task:task/timekeeper/t_01/reward"},"subtasks":[{"field":"wing","target":1,"label":{"translate":"task.scr.timekeeper.t_01.objective.wing","fallback":"获得幻梦翎片","color":"white"}}],"ui":{"title":{"translate":"task.scr.timekeeper.t_01.title","fallback":"天降鹰翎","color":"gold"},"description":{"translate":"task.scr.timekeeper.t_01.description","fallback":"等待一次在线奖励，获得幻梦翎片。","color":"white"},"objectives":{"translate":"task.scr.timekeeper.t_01.instructions","fallback":"每十分钟发放在线奖励。开始任务时已有幻梦翎片余额，也会直接认可。幻梦翎片可由行商鹰开启。","color":"white"},"rewards":{"translate":"task.scr.timekeeper.t_01.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、50 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.timekeeper.t_01.accept","fallback":"你似乎在寻找鹰翎。\n\n不必着急。\n\n有些东西不是靠挖掘得到，也不是靠购买得到。\n\n只需要时间。\n\n每在这里度过十分钟，你都会获得一枚幻梦翎片。\n\n等下一枚落到你手里，再回来找我。","color":"white"},"submit":{"translate":"task.scr.timekeeper.t_01.submit","fallback":"看到了吗？\n\n时间不会凭空创造价值，但留下来的时间，总会留下痕迹。\n\n幻梦翎片可以交给行商鹰开启。\n\n至于里面会出现什么——那就不是我负责记录的事情了。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"timekeeper/t_02","group":"timekeeper","name":"t_02","title":"日复一日","requires":[{"group":"timekeeper","name":"t_01"}],"hooks":{"start":"scr_task:task/timekeeper/t_02/start","check_complete":"scr_task:task/timekeeper/t_02/check_complete","reward":"scr_task:task/timekeeper/t_02/reward"},"subtasks":[{"field":"sign_in","target":1,"label":{"translate":"task.scr.timekeeper.t_02.objective.sign_in","fallback":"完成今天的签到","color":"white"}}],"ui":{"title":{"translate":"task.scr.timekeeper.t_02.title","fallback":"日复一日","color":"gold"},"description":{"translate":"task.scr.timekeeper.t_02.description","fallback":"完成一次自动每日签到。","color":"white"},"objectives":{"translate":"task.scr.timekeeper.t_02.instructions","fallback":"当天累计在线 5 分钟即可自动签到，无需输入命令。如果今天已经签到，接取任务即可完成此目标。","color":"white"},"rewards":{"translate":"task.scr.timekeeper.t_02.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、100 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.timekeeper.t_02.accept","fallback":"十分钟只是一小段时间。\n\n一天，又是另一回事。\n\n鹰翎镇不需要你每天站在这里向我报到。\n\n当天累计在线达到要求，签到自然会完成。\n\n一天如此，两天如此，日复一日。\n\n持续留下的记录，往往比某一天多待几个小时更有意义。","color":"white"},"submit":{"translate":"task.scr.timekeeper.t_02.submit","fallback":"今天的记录已经留下了。\n\n明天会有新的那一页。\n\n连续的日子越多，你以后能得到的东西也会有所不同。\n\n不用赶时间。\n\n我最不缺的，就是时间。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"herald/h_01","group":"herald","name":"h_01","title":"鹰眼识珍","requires":[{"group":"guardian","name":"g_01"}],"hooks":{"start":"scr_task:task/herald/h_01/start","check_complete":"scr_task:task/herald/h_01/check_complete","reward":"scr_task:task/herald/h_01/reward"},"subtasks":[{"field":"gallery","target":1,"label":{"translate":"task.scr.herald.h_01.objective.gallery","fallback":"打开展览馆","color":"white"}}],"ui":{"title":{"translate":"task.scr.herald.h_01.title","fallback":"鹰眼识珍","color":"gold"},"description":{"translate":"task.scr.herald.h_01.description","fallback":"打开展览馆，认识值得展示的收藏。","color":"white"},"objectives":{"translate":"task.scr.herald.h_01.instructions","fallback":"使用 /trigger gallery 打开展览馆。","color":"white"},"rewards":{"translate":"task.scr.herald.h_01.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、50 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.herald.h_01.accept","fallback":"嘿！先别急着走！\n\n冒险得到的好东西，难道都要塞进箱子里吃灰吗？\n\n当然不！\n\n挂画、唱片、收藏品——值得被记住的东西，就该摆出来让大家看见。\n\n打开展览馆逛一圈。\n\n看看以后有什么东西值得你亲自送进去。","color":"white"},"submit":{"translate":"task.scr.herald.h_01.submit","fallback":"怎么样？\n\n总有一天，那里也会出现属于你的收藏。\n\n记住，稀有只是价值的一部分。\n\n真正让一件东西值得展示的，是你知道自己从哪里得到它。","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"herald/h_02","group":"herald","name":"h_02","title":"鹰立鸡群","requires":[{"group":"herald","name":"h_01"}],"hooks":{"start":"scr_task:task/herald/h_02/start","check_complete":"scr_task:task/herald/h_02/check_complete","reward":"scr_task:task/herald/h_02/reward"},"subtasks":[{"field":"title","target":1,"label":{"translate":"task.scr.herald.h_02.objective.title","fallback":"打开称号界面","color":"white"}},{"field":"hat","target":1,"label":{"translate":"task.scr.herald.h_02.objective.hat","fallback":"成功把主手物品戴到头部","color":"white"}}],"ui":{"title":{"translate":"task.scr.herald.h_02.title","fallback":"鹰立鸡群","color":"gold"},"description":{"translate":"task.scr.herald.h_02.description","fallback":"查看称号，再给自己戴上一件显眼的东西。","color":"white"},"objectives":{"translate":"task.scr.herald.h_02.instructions","fallback":"使用 /trigger title 查看称号。清空头部装备，主手拿着物品，使用 /trigger sethat；只有成功戴上才会计入。","color":"white"},"rewards":{"translate":"task.scr.herald.h_02.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、50 鹰翎币、3 翎钻。请在鹰翎镇领取。","color":"white"},"accept":{"translate":"task.scr.herald.h_02.accept","fallback":"冒险者这么多，怎么让别人一眼就记住你？\n\n装备？太普通。\n\n名字？大家都有。\n\n当然得靠点更显眼的东西！\n\n看看你的称号，再找件顺眼的东西戴到头上。\n\n别担心，好不好看是另一回事。\n\n先做到足够显眼！","color":"white"},"submit":{"translate":"task.scr.herald.h_02.submit","fallback":"很好！\n\n现在至少从远处看，你已经不像刚来的新人了。\n\n以后完成挑战、参加活动，还会有更多称号可以选择。\n\n至于头上戴什么……\n\n审美问题不归号角鹰负责！","color":"white"}}}
data modify storage scr_task:runtime catalog append value {"id":"skywing/sky_00","group":"skywing","name":"sky_00","title":"云端来客","requires":[{"group":"guardian","name":"g_01"}],"hooks":{"cleanup":"scr_task:task/skywing/sky_00/cleanup","start":"scr_task:task/skywing/sky_00/start","check_complete":"scr_task:task/skywing/sky_00/check_complete","reward":"scr_task:task/skywing/sky_00/reward"},"subtasks":[{"field":"island","target":1,"label":{"translate":"task.scr.skywing.sky_00.objective.island","fallback":"拥有自己的空岛","color":"white"}},{"field":"entered","target":1,"label":{"translate":"task.scr.skywing.sky_00.objective.entered","fallback":"进入鹰翎云境","color":"white"}}],"ui":{"title":{"translate":"task.scr.skywing.sky_00.title","fallback":"云端来客","color":"gold"},"description":{"translate":"task.scr.skywing.sky_00.description","fallback":"创建自己的空岛，踏入鹰翎云境。","color":"white"},"objectives":{"translate":"task.scr.skywing.sky_00.instructions","fallback":"通过 /trigger sky 创建自己的空岛并进入鹰翎云境。已有可用的个人空岛也算完成第一个目标。进入空岛地狱或空岛末地不计入第二个目标。","color":"white"},"rewards":{"translate":"task.scr.skywing.sky_00.rewards","fallback":"提交后寄送奖励邮件: 50 灵魂、150 鹰翎币、3 翎钻。请在鹰翎云境领取。","color":"white"},"accept":{"translate":"task.scr.skywing.sky_00.accept","fallback":"你也是来问天空上面有什么的吗？\n\n多数人问完以后就走了。\n\n因为他们真正想知道的，其实是那里有没有宝藏。\n\n很遗憾。\n\n那里几乎什么都没有。\n\n一棵树，一块土地，还有看不到尽头的虚空。\n\n你在这里积累的东西，也不会替你在那里解决问题。\n\n如果听到这些以后，你还是想去——\n\n那就为自己建一座岛吧。\n\n等你真正站到云层之上，我们再谈接下来的事情。","color":"white"},"submit":{"translate":"task.scr.skywing.sky_00.submit","fallback":"欢迎来到云海。\n\n现在，回头看看。\n\n你以前拥有的一切并没有消失。\n\n只是留在了另一个世界。\n\n而这里——\n\n才刚刚开始。","color":"white"}}}
